{
  "expo": {
    "name": "Shady",
    "slug": "shady",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/shady-icon.png",
    "scheme": "shady",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.shady.krakow",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Find a walking start near you in Kraków."
      },
      "icon": "./assets/shady-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/shady-icon.png",
        "backgroundColor": "#F5FAF8"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.shady.krakow",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/shady-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5FAF8"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Find a walking start near you in Kraków."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e5c49376-9706-4d84-bcc2-704deaef5039"
      }
    },
    "owner": "undeluro"
  }
}
